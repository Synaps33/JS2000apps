var W = 320, H = 240;

var BTN_UP    = 1<<4;
var BTN_DOWN  = 1<<5;
var BTN_LEFT  = 1<<6;
var BTN_RIGHT = 1<<7;
var BTN_B     = 1<<0;
var BTN_A     = 1<<8;
var BTN_START = 1<<3;
var BTN_L     = 1<<10;
var BTN_R     = 1<<11;

// =======================
// ACHIEVEMENTS SYSTEM
// =======================
var ACH_PATH = "/mnt/sda1/sajnaps/froggy_jump2_ach.json";

var Achievements = (function(){

  var list = {};
  var unlocked = {};
  var queue = [];

  var current = null;
  var timer = 0;

  var DURATION = 170;
  var ANIM = 15;

  function add(id, title, desc){
    list[id] = {title:title, desc:desc};
  }

  function unlock(id){
    if(!list[id] || unlocked[id]) return;
    unlocked[id] = true;
    queue.push(list[id]);
    saveAchievements();
  }

  function update(){
    if(!current && queue.length>0){
      current = queue.shift();
      timer = 0;
    }

    if(current){
      timer++;
      if(timer > DURATION) current = null;
    }
  }

  function draw(){
    if(!current) return;

    var w = Math.floor(320 * 0.7);
    var h = 32;
    var x = (320 - w) >> 1;

    var t = timer;
    var y;

    if(t < ANIM){
      var k = t/ANIM;
      k = 1-(1-k)*(1-k);
      y = -h + (h+8)*k;
    } else if(t > DURATION-ANIM){
      var k2 = (t-(DURATION-ANIM))/ANIM;
      k2 = k2*k2;
      y = 8 - (h+8)*k2;
    } else y = 8;

    ScreenDraw.fillRect(x+2,y+2,w,h,0x55000000);
    ScreenDraw.fillRect(x,y,w,h,0xFF555555);
    ScreenDraw.rect(x,y,w,h,0xFFAAAAAA);

    ScreenDraw.text5x8(x+8,y+6,current.title,0xFFFFFF00);
    ScreenDraw.text5x8(x+8,y+18,current.desc,0xFFFFFFFF);
  }

  return {
    add:add,
    unlock:unlock,
    update:update,
    draw:draw,
    _getAll:function(){return list;},
    _getUnlocked:function(){return unlocked;}
  };

})();


function safeInput(){ try{ return getInputState(); }catch(e){ return 0; } }
function safeReadText(p){ try{ return FS.readTextFile(p); }catch(e){ return null; } }
function safeWriteText(p,t){ try{ return FS.writeTextFile(p,t); }catch(e){ return false; } }

var SAVE_PATH = "/mnt/sda1/sajnaps/froggy_jump2_highscore.json";




function drawMenuButton(x, y, w, h, text, selected){
  var bg = selected ? 0xFFB58B54 : 0xFF8B5A2B;
  var border = 0xFF3A240F;
  var highlight = 0xFFD9A066;

  // cień
  ScreenDraw.fillRect(x+2, y+2, w, h, 0x22000000);

  // tło
  ScreenDraw.fillRect(x, y, w, h, bg);

  // highlight (góra)
  ScreenDraw.fillRect(x, y, w, 3, highlight);

  // border
  ScreenDraw.rect(x, y, w, h, border);

  // tekst (wyśrodkowany)
  var tx = Math.floor(x + (w - text.length*8)/2);
  var ty = y + Math.floor((h-8)/2);

  ScreenDraw.text8x8(tx, ty, text, selected ? 0xFF000000 : 0xFFFFFFFF);
}
var state = "menu";
var tick = 0;

var player = {
  x: W/2,
  y: H - 60,
  w: 16,
  h: 16,
  vx: 0,
  vy: 0,
  onPlatform: false,
  runSpeed: 0,
  maxRunSpeed: 6,
  accel: 0.28,
  decel: 0.5,
  baseJump: -6.6,
  gravity: 0.64
};

var PLATFORM_SPACING = 48;
var VISIBLE_PLATFORMS = 5;
var platforms = [];
var worldOffsetY = 0;

var MIN_PW = 40, MAX_PW = 160;
var MARGIN = 8;

var score = 0;
var highscore = 0;

var particles = [];

var clouds = { x:0, speed: 0.31 };
var mid = { x:0, speed: 0.72 };
var fg = { x:0, speed: 0 };

var menuIndex = 0;
var menuItems = ["START", "CONTINUE", "ACHIEVEMENTS", "CONTROLS"];



var prevInput = 0;
var lastSaveTick = 0;

var TIME_OF_DAY_LIST = ["morning","noon","sunset","night"];
var timeOfDay = "noon";
var sunCfg = { x: 60, y: 36, color: 0xFFFFFF00 };

var menuFrogTick = 0;

function rand(min,max){ return Math.floor(min + Math.random()*(max-min+1)); }
function clamp(v,a,b){ if(v<a) return a; if(v>b) return b; return v; }

function makePlatform(y){
  var w = rand(MIN_PW, MAX_PW);
  var x = rand(MARGIN, Math.max(MARGIN, W - w - MARGIN));
  return { x:x, y:y, w:w, h:8 };
}

function pickRandomTimeOfDay(){
  timeOfDay = TIME_OF_DAY_LIST[rand(0, TIME_OF_DAY_LIST.length-1)];
  if(timeOfDay === "morning"){
    sunCfg.color = 0xFFFFD680;
    sunCfg.x = rand(40, 110);
    sunCfg.y = rand(28, 46);
  } else if(timeOfDay === "noon"){
    sunCfg.color = 0xFFFFFF88;
    sunCfg.x = rand(140, 220);
    sunCfg.y = rand(20, 40);
  } else if(timeOfDay === "sunset"){
    sunCfg.color = 0xFFFFA040;
    sunCfg.x = rand(80, 200);
    sunCfg.y = rand(30, 60);
  } else {
    sunCfg.color = 0xFF9999AA;
    sunCfg.x = rand(40, 220);
    sunCfg.y = rand(24, 56);
  }
}

function initStage(){
  pickRandomTimeOfDay();

  platforms = [];

  var baseY = H - 20;
  platforms.push({ x:0, y: baseY, w: W, h: 10 });

  for(var i=1;i<=VISIBLE_PLATFORMS;i++){
    var py = baseY - i*PLATFORM_SPACING;
    platforms.push(makePlatform(py));
  }

  var extraY = baseY - (VISIBLE_PLATFORMS+1)*PLATFORM_SPACING;
  platforms.push(makePlatform(extraY));

  player.x = Math.floor((W - player.w)/2);
  player.y = platforms[0].y - player.h - 2;
  player.vx = 0; player.vy = 0; player.onPlatform = true; player.runSpeed = 0;
  score = 0;
  worldOffsetY = 0;
  particles = [];
}

function saveHighscore(){
  try{
    var obj = { highscore: highscore, last: (new Date()).toISOString() };
    safeWriteText(SAVE_PATH, JSON.stringify(obj));
  }catch(e){}
}
function loadAchievements(){
  try{
    var t = safeReadText(ACH_PATH);
    if(t){
      var data = JSON.parse(t);
      var u = Achievements._getUnlocked();
      for(var k in data) u[k] = true;
    }
  }catch(e){}
}

function saveAchievements(){
  try{
    var out = {};
    var u = Achievements._getUnlocked();
    for(var k in u) out[k]=1;
    safeWriteText(ACH_PATH, JSON.stringify(out));
  }catch(e){}
}


function loadHighscore(){
  try{
    var t = safeReadText(SAVE_PATH);
    if(t){
      var o = JSON.parse(t);
      highscore = o.highscore || 0;
    } else highscore = 0;
  }catch(e){ highscore = 0; }
}



Achievements.add("score250","Warming Up","Reach 250 points");
Achievements.add("score800","Climbing High","Reach 800 points");
Achievements.add("score1200","Halfway There","Reach 1200 points");
Achievements.add("score1700","Unstoppable","Reach 1700 points");
Achievements.add("score2300","Sky Walker","Reach 2300 points");
Achievements.add("score3000","Above the Clouds","Reach 3000 points");
Achievements.add("score4000","Almost Legendary","Reach 4000 points");
Achievements.add("score5000","Frog Legend","Reach 5000 points");

function spawnParticles(x,y,count,avgV){
  for(var i=0;i<count;i++){
    var ang = (Math.PI*0.6) + (Math.random()-0.5)*1.2;
    particles.push({
      x:x + (Math.random()-0.5)*6,
      y:y + (Math.random()-0.5)*6,
      vx: Math.cos(ang) * avgV * (0.6 + Math.random()*0.8),
      vy: Math.sin(ang) * avgV * (0.6 + Math.random()*0.8),
      life: 20 + Math.floor(Math.random()*30),
      col: 0xFFFFFF66
    });
  }
}

function checkLanding(prevY){
  if(player.vy <= 0) return false;
  var prevFeet = prevY + player.h;
  var currFeet = player.y + player.h;
  for(var i = platforms.length - 1; i >= 0; i--){
    var p = platforms[i];
    var platTop = p.y + worldOffsetY;
    if(platTop < -100 || platTop > H + 100) continue;
    if(prevFeet <= (platTop - 0.5) && currFeet >= (platTop - 0.5)){
      var left = player.x + 2;
      var right = player.x + player.w - 2;
      if(right >= p.x && left <= (p.x + p.w)){
        player.y = platTop - player.h;
        player.vy = 0;
        player.onPlatform = true;
        return true;
      }
    }
  }
  return false;
}

function handleAscend(){
  var ascendThreshold = Math.floor(H * 0.36);
  if(player.y <= ascendThreshold){
    var dy = Math.floor(ascendThreshold - player.y);
    if(dy <= 0) return;
    worldOffsetY += dy;
    player.y += dy;

    while(platforms.length > 0 && (platforms[0].y + worldOffsetY) > (H + 40)){
      platforms.shift();
    }
    while(platforms.length < VISIBLE_PLATFORMS + 1){
      var last = platforms.length>0 ? platforms[platforms.length-1].y : (H - 20);
      var topY = last - PLATFORM_SPACING;
      platforms.push(makePlatform(topY));
    }

    var newScore = Math.floor(worldOffsetY/10);
if(newScore > score){
  score = newScore;

  
if(score >= 250) Achievements.unlock("score250");
if(score >= 800) Achievements.unlock("score800");
if(score >= 1200) Achievements.unlock("score1200");
if(score >= 1700) Achievements.unlock("score1700");
if(score >= 2300) Achievements.unlock("score2300");
if(score >= 3000) Achievements.unlock("score3000");
if(score >= 4000) Achievements.unlock("score4000");
if(score >= 5000) Achievements.unlock("score5000");
}
  }
}

function updateParticles(){
  for(var i=particles.length-1;i>=0;i--){
    var q = particles[i];
    q.x += q.vx;
    q.y += q.vy;
    q.vy += 0.18;
    q.life -= 1;
    if(q.life <= 0) particles.splice(i,1);
  }
}

function drawParallax(dt){
  var skyCol = 0xFF88CCFF;
  if(timeOfDay === "morning") skyCol = 0xFFB7E6FF;
  else if(timeOfDay === "noon") skyCol = 0xFF7FD4FF;
  else if(timeOfDay === "sunset") skyCol = 0xFFFFC8A0;
  else if(timeOfDay === "night") skyCol = 0xFF1A2340;

  ScreenDraw.fillRect(0,0,W, H, skyCol);

  sunCfg.x += (Math.sin(tick * 0.003) * 0.2);
  sunCfg.y += (Math.cos(tick * 0.002) * 0.08);
  var sunX = Math.floor(sunCfg.x);
  var sunY = Math.floor(sunCfg.y);

  var sc = sunCfg.color;
  var srad = (timeOfDay === "noon") ? 12 : 10;
  ScreenDraw.fillRect(sunX - srad, sunY - srad, srad*2, srad*2, sc);

  if(timeOfDay !== "night"){
    ScreenDraw.fillRect(sunX - srad - 6, sunY - srad - 4, (srad*2)+12, (srad*2)+8, (sc & 0x00FFFFFF) | 0x33000000);
  } else {
    ScreenDraw.fillRect(sunX - srad - 2, sunY - srad - 2, (srad*2)+4, (srad*2)+4, 0x33334444);
  }

  clouds.x = (clouds.x + clouds.speed * dt) % (W+200);
  var cx = Math.floor(-100 + clouds.x);
  for(var i=0;i<6;i++){
    var px = (cx + i*120) % (W+240) - 80;
    var cloudCol = (timeOfDay === "night") ? 0xFF2E2F45 : 0xFFDDEEFF;
    ScreenDraw.fillRect(px, 14, 80, 20, cloudCol);
  }

  mid.x = (mid.x + mid.speed * dt) % (W+200);
  var mx = Math.floor(-100 + mid.x);
  for(var i=0;i<5;i++){
    var px = (mx + i*160) % (W+260) - 80;
    var midCol = (timeOfDay === "night") ? 0xFF2B3B3B : 0xFFB0DFF0;
    ScreenDraw.fillRect(px, 40, 110, 22, midCol);
  }

  fg.x = (fg.x + fg.speed * dt) % (W+200);
  var fx = Math.floor(-100 + fg.x);
  var hillCol = (timeOfDay === "night") ? 0xFF223322 : 0xFF94D0A2;
  for(var i=0;i<4;i++){
    var px = (fx + i*220) % (W+260) - 80;
    ScreenDraw.fillRect(px, H-60, 220, 60, hillCol);
  }
}

function drawPlatforms(){
  for(var i=0;i<platforms.length;i++){
    var p = platforms[i];
    var py = Math.floor(p.y + worldOffsetY);
    if(py > H+20) continue;
    if(py < -40) continue;
    ScreenDraw.fillRect(p.x, py, p.w, p.h, 0xFF444444);
    ScreenDraw.rect(p.x, py, p.w, p.h, 0xFF222222);
  }
}

function drawPlayer(){
  ScreenDraw.fillRect(
    Math.floor(player.x+2),
    Math.floor(player.y+player.h),
    player.w-4,
    4,
    0x22000000
  );

  ScreenDraw.fillRect(
    Math.floor(player.x),
    Math.floor(player.y),
    player.w,
    player.h,
    0xFF2E8B2E
  );

  var ox = Math.floor(player.x);
  var oy = Math.floor(player.y);

  ScreenDraw.fillRect(
    ox + Math.floor(player.w*0.25),
    oy + Math.floor(player.h*0.20),
    3, 3,
    0xFF000000
  );

  ScreenDraw.fillRect(
    ox + Math.floor(player.w*0.65),
    oy + Math.floor(player.h*0.20),
    3, 3,
    0xFF000000
  );

  ScreenDraw.rect(
    Math.floor(player.x),
    Math.floor(player.y),
    player.w,
    player.h,
    0xFF103010
  );
}

function drawParticles(){
  for(var i=0;i<particles.length;i++){
    var p = particles[i];
    ScreenDraw.fillRect(Math.floor(p.x), Math.floor(p.y), 2, 2, p.col);
  }
}

function drawHUD(){
  ScreenDraw.text8x8(8,8, "Score: " + score, 0xFFFFFFFF);
  ScreenDraw.text8x8(W-120,8, "High: " + highscore, 0xFFFFFF88);
}

function drawGameOver(){
  ScreenDraw.fillRect(40,60, W-80, 120, 0xFF101010);
  ScreenDraw.rect(40,60, W-80, 120, 0xFFFFFF88);
  var txt = "GAME OVER";
  ScreenDraw.text8x8(Math.floor((W - txt.length*8)/2), 72, txt, 0xFFFF8888);
  ScreenDraw.text8x8(Math.floor((W - ("Score: "+score).length*8)/2), 96, "Score: " + score, 0xFFFFFFCC);
  ScreenDraw.text8x8(Math.floor((W - ("Highscore: "+highscore).length*8)/2), 112, "Highscore: " + highscore, 0xFFFFFFCC);
  ScreenDraw.text8x8(Math.floor((W - "Press A to restart".length*8)/2), 140, "Press A to restart", 0xFFCCCCCC);
}

function drawMenuPlayerFrog(x, y, tickLocal){
  var w = Math.max(6, Math.floor(player.w * 0.75));
  var h = player.h;

  ScreenDraw.fillRect(Math.floor(x), Math.floor(y), Math.floor(w), h, 0xFF2E8B2E);
  ScreenDraw.rect(Math.floor(x), Math.floor(y), Math.floor(w), h, 0xFF103010);

  var eyeSize = 2;
  ScreenDraw.fillRect(Math.floor(x + w*0.20), Math.floor(y + 3), eyeSize, eyeSize, 0xFF000000);
  ScreenDraw.fillRect(Math.floor(x + w*0.60), Math.floor(y + 3), eyeSize, eyeSize, 0xFF000000);
}
function drawAchievements(){
  ScreenDraw.clear(0xFF1A1A1A);

  ScreenDraw.text8x8(80,10,"ACHIEVEMENTS",0xFFFFFF00);

  var all = Achievements._getAll();
  var u = Achievements._getUnlocked();

  var y = 20;

  for(var id in all){
    var a = all[id];
    var ok = u[id];

    ScreenDraw.fillRect(20,y,280,20, ok?0xFF444444:0xFF222222);
    ScreenDraw.rect(20,y,280,20,0xFF666666);

    if(ok){
      ScreenDraw.text5x8(30,y+4,a.title,0xFFFFFF00);
      ScreenDraw.text5x8(30,y+12,a.desc,0xFFFFFFFF);
    }else{
      ScreenDraw.text5x8(30,y+6,"?????",0xFF777777);
    }

    y+=26;
  }

  ScreenDraw.text5x8(100,220,"B - BACK",0xFFFFFFFF);
}
function drawMenu(){
  drawParallax(8);

  // tytuł
  var title = "FROGGY JUMP";
  var tx = Math.floor((W - title.length*8)/2);
  ScreenDraw.text8x8(tx, 20, title, 0xFF003300);
  ScreenDraw.text8x8(tx+1, 21, title, 0xFF00AA44);

  // żabka bounce
  menuFrogTick++;
  var bounce = Math.floor(Math.sin(menuFrogTick * 0.12) * 6);
  drawMenuPlayerFrog(Math.floor(W/2 - 6), 50 + bounce, menuFrogTick);

  // przyciski
  var bw = 160;
  var bh = 18;
  var startY = 110;

  for(var i=0;i<menuItems.length;i++){
    var x = Math.floor((W - bw)/2);
    var y = startY + i*26;

    drawMenuButton(x, y, bw, bh, menuItems[i], i === menuIndex);
  }

  ScreenDraw.text5x8(70, H-16, "UP/DOWN + A", 0xFF333333);
}
function drawControls(){
  ScreenDraw.clear(0xFF88CCFF);
  ScreenDraw.text8x8(30, 36, "Controls:", 0xFF003300);
  ScreenDraw.text8x8(30, 56, "Left/Right or LR to Move", 0xFF003300);
  ScreenDraw.text8x8(30, 72, "Faster you run", 0xFF003300);
  ScreenDraw.text8x8(30, 87, "Higher you jump", 0xFF003300);
  ScreenDraw.text8x8(30, 120, " (c) Sajnaps", 0xFF003300);
  ScreenDraw.text8x8(40, H-30, "B to back", 0xFF003300);
}

function updatePhysics(s, dt){
  var holdingRight = (s & BTN_RIGHT) !== 0;
  var holdingLeft = (s & BTN_LEFT) !== 0;
  var holdingRightR = (s & BTN_R) !== 0;
  var holdingLeftL = (s & BTN_L) !== 0;
  if(holdingRight || holdingRightR){
    player.runSpeed = clamp(player.runSpeed + player.accel, 0, player.maxRunSpeed);
    player.vx = player.runSpeed;
  } else if(holdingLeft || holdingLeftL){
    player.runSpeed = clamp(player.runSpeed - player.accel, -player.maxRunSpeed, 0);
    player.vx = player.runSpeed;
  } else {
    if(player.runSpeed > 0) player.runSpeed = Math.max(0, player.runSpeed - player.decel);
    else if(player.runSpeed < 0) player.runSpeed = Math.min(0, player.runSpeed + player.decel);
    player.vx = player.runSpeed;
  }

  player.x += player.vx;
  if(player.x < 2) { player.x = 2; player.runSpeed = 0; player.vx = 0; }
  if(player.x + player.w > W-2) { player.x = W-2 - player.w; player.runSpeed = 0; player.vx = 0; }

  var prevY = player.y;

  player.vy += player.gravity;
  player.y += player.vy;

  if(checkLanding(prevY)){
    var runFactor = Math.abs(player.runSpeed) / Math.max(1, player.maxRunSpeed);
    var jumpStrength = player.baseJump * (1 + runFactor*1.2);
    player.vy = jumpStrength;
    player.onPlatform = false;
    if(Math.abs(jumpStrength) > 9){
      spawnParticles(player.x + player.w/2, player.y + player.h/2, 16, 2.8);
    } else if(Math.abs(jumpStrength) > 8){
      spawnParticles(player.x + player.w/2, player.y + player.h/2, 10, 2.0);
    }
  }

  handleAscend();

  var lowestPlatformY = platforms.length>0 ? (platforms[0].y + worldOffsetY) : H+100;
  if(player.y > lowestPlatformY + 36){
    if(score > highscore){ highscore = score; saveHighscore(); }
    state = "gameover";
  }
}

var lastTime = Date.now();
function frame(){
  var now = Date.now();
  var dtMs = now - lastTime;
  if(dtMs <= 0) dtMs = 16;
  lastTime = now;
  var dt = dtMs / 16.666;
  tick++;

  var s = safeInput();
var changed = s ^ prevInput;

if(state === "menu"){
  if((changed & BTN_UP) && (s & BTN_UP)) menuIndex = Math.max(0, menuIndex-1);
  if((changed & BTN_DOWN) && (s & BTN_DOWN)) menuIndex = Math.min(menuItems.length-1, menuIndex+1);

  if((changed & BTN_A) && (s & BTN_A)){
    var sel = menuItems[menuIndex];

    if(sel === "START"){
      state = "playing"; initStage();
    } else if(sel === "HIGHSCORE"){
      setInfo("Highscore: " + highscore, 120);
    } else if(sel === "CONTROLS"){
      state = "controls";
    } else if(sel === "ACHIEVEMENTS"){
      state = "achievements";
    }
  }

  if((changed & BTN_START) && (s & BTN_START)){
    saveHighscore();
    setInfo("Saved highscore", 80);
  }

} else if(state === "controls"){
  if((changed & BTN_B) && (s & BTN_B)) state = "menu";

} else if(state === "playing"){
  updatePhysics(s, dt);
  updateParticles();

} else if(state === "achievements"){   
  if((changed & BTN_B) && (s & BTN_B)){
    state = "menu";
  }

} else if(state === "gameover"){
  if((changed & BTN_A) && (s & BTN_A)){
    state = "menu";
  }
}

  if(state === "menu"){
  drawMenu();
} else if(state === "controls"){
  drawControls();
} else if(state === "achievements"){
  drawAchievements();   
} else {
  drawParallax( dtMs * 0.06 );
  drawPlatforms();
  drawParticles();
  drawPlayer();
  drawHUD();
  if(state === "gameover") drawGameOver();
}

  if(infoTimer && infoTimer>0){
    infoTimer--;
    ScreenDraw.text8x8(8, H-18, infoMsg, 0xFFFFFF88);
    if(infoTimer<=0) infoMsg = "";
  }

  prevInput = s;
  Achievements.update();
Achievements.draw();
}

var infoTimer = 0, infoMsg = "";
function setInfo(msg, t){ infoMsg = msg; infoTimer = t || 80; }

loadHighscore();
loadAchievements();
setMainLoop(frame);

try{ this._froggy_jump2_reset = function(){ state='menu'; initStage(); loadHighscore(); }; }catch(e){} 
